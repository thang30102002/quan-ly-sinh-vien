# Copy thành .env rồi sửa nếu cần: cp .env.example .env

# Cổng PostgreSQL trên máy thật (5432 thường đã bị PostgreSQL cài sẵn chiếm)
DB_PORT=5435

# Tài khoản CSDL. Chỉ có hiệu lực khi tạo volume lần đầu;
# đổi sau đó thì phải docker compose down -v rồi up lại
DB_USER=qlsv
DB_PASSWORD=qlsv

# Cổng pgAdmin (tùy chọn): http://localhost:5050
PGADMIN_PORT=5050
